# Copy to .env.local and fill in (Next.js only reads the dotted .env.local). Never commit .env.local.

# AG Studio licence key (the Insights dashboard). Get a 45-day trial at
# ag-grid.com/studio -> Pricing -> the AG Studio card -> "Start a 45-day free trial".
AG_STUDIO=

# Free-tier key from aistudio.google.com -> Get API key. Powers narrateClaims() (the case file in
# Decisions; without it, the original scripted claim sentences) and AG Studio's AI assistant on
# Insights (the Ask bar, and Edit dashboard -> AI Assistant; without a model key neither is offered).
# The assistant is called only from the server route app/api/studio-ai, so no key reaches the
# browser. It tries the free models in STUDIO_AI_GEMINI_MODELS in order (default
# gemini-3.1-flash-lite,gemini-3-flash-preview; each has its own small daily quota), skipping one
# until its quota resets. STUDIO_AI_MAX_CALLS caps model calls per server process (default 400);
# STUDIO_AI_DEBUG=1 logs each agent turn to the server console.
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Optional, paid: the assistant's last resort through OpenRouter, once the free Gemini models have
# used their quota for the day (or the only one, without GEMINI_API_KEY).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b
