# Copy to .env.local and fill in (Next.js only reads the dotted .env.local). Never commit .env.local.

# AG Studio licence key (the Insights dashboard). Get a 45-day trial at
# ag-grid.com/studio -> Pricing -> the AG Studio card -> "Start a 45-day free trial".
AG_STUDIO=

# Free-tier key from aistudio.google.com -> Get API key. Powers narrateClaims() (the ring detail
# page's case file). Omit it and the page falls back to the original scripted claim sentences.
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Optional: AG Studio's AI assistant (Insights -> the Ask bar, and Edit dashboard -> AI Assistant), through
# OpenRouter. Called only from the server route app/api/studio-ai, so the key never reaches the
# browser. Without it neither is offered. STUDIO_AI_MAX_CALLS caps model calls per
# server process (default 400); STUDIO_AI_DEBUG=1 logs each agent turn to the server console.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b
