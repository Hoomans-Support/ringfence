{
  "name": "ringfence-api",
  "version": "0.0.1",
  "description": "A drop-in for PayPal Payouts: accepts PayPal's own Payouts request body plus optional per-payee context, decides every payee (PAY, HOLD or BLOCK), and sends the paid ones to PayPal as one batch, exactly once. Every `/v1` route takes a program's API key as a bearer token; a program's read-only MCP key may only call `GET` routes and `POST /v1/screen`.\nThis spec covers the REST surface only. `POST /mcp` (the MCP server for AI agents — `screen_payees`, `explain_ring`) speaks the Model Context Protocol's own Streamable HTTP transport, not plain REST/JSON, and isn't represented here.\n",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "tshy": {
    "exports": {
      ".": "./src/index.ts",
      "./package.json": "./package.json"
    },
    "dialects": [
      "esm",
      "commonjs"
    ],
    "project": "./tsconfig.tshy.json",
    "selfLink": false
  },
  "main": "./dist/commonjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "tsconfig.tshy.json",
    "README.md",
    "api-reference.md",
    "sdk-map.md",
    "map"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "prepare": "tshy",
    "build": "tshy",
    "smoke": "node -e \"require('ringfence-api')\" && node --input-type=module -e \"import('ringfence-api')\"",
    "typecheck": "tsc --noEmit",
    "typecheck:dom": "tsc --noEmit -p tsconfig.dom.json",
    "lint": "oxlint --type-aware --max-warnings=0 src",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tshy": "^4.1.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "zod": "^4.1.0"
  }
}
