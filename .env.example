# Copy to .env and fill in. Never commit .env.
# Sandbox credentials: developer.paypal.com -> Apps & Credentials -> Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# mock (default: in-memory PayPal, nothing leaves the machine) or sandbox (the real client above)
PAYPAL_MODE=mock
# Spacing between real PayPal calls; the sandbox blocks an IP after 50 requests a minute
PAYPAL_MIN_INTERVAL_MS=1500
# The sandbox's real cancel answers 500; true uses PayPal's sandbox test ID POSPOI002 instead (labelled in the audit log)
PAYPAL_CANCEL_WITH_TEST_IDS=true
# npm run smoke: the sandbox *personal* account email that test 2 pays $1.00
SMOKE_RECEIVER=
# npm run smoke, test 6: a deployed Ringfence API whose GET /v1/webhooks/events lists verified webhooks
RINGFENCE_API_URL=

# Set after registering the webhook in the PayPal dashboard (Apps & Credentials -> your app -> Webhooks)
PAYPAL_WEBHOOK_ID=

# Ringfence API (apps/api). Postgres URL, or pglite://memory (the default) / pglite:./.data to run with no database server
DATABASE_URL=pglite://memory
# The program the API key below signs in as; the key is stored only as a hash
RINGFENCE_PROGRAM_ID=budgetapp
# Optional: where the program's ring and rule numbering starts (the hosted demo uses 12 and 7, so its
# week 1 ring is R-12 and its first learned rule R-07). Unset, a program starts at 1.
RINGFENCE_FIRST_RING_NUMBER=
RINGFENCE_FIRST_RULE_NUMBER=
RINGFENCE_API_KEY=
# Read-only key for AI agents on the MCP server (POST /mcp): screens and explains, never sends or releases
RINGFENCE_MCP_KEY=

# The ring network (FR-19, stretch): confirmed rings are shared across programs as HMAC-SHA256
# hashes under this key, never raw data. Every program on one deployment must share the same key,
# or they can't recognize each other's confirmed rings. Omit it and the network quietly does
# nothing (no publish, no match) rather than failing a run.
RINGFENCE_NETWORK_KEY=
# Optional second tenant used by the cross-program survey-app demo. Configure the same key on the console host.
RINGFENCE_SURVEY_PROGRAM_ID=surveyapp
RINGFENCE_SURVEY_PROGRAM_NAME=Survey app
RINGFENCE_SURVEY_API_KEY=
# Log in with PayPal uses a separate sandbox identity app from the Payouts API credentials.
PAYPAL_LOGIN_CLIENT_ID=
PAYPAL_LOGIN_CLIENT_SECRET=
RINGFENCE_SELF_RELEASE_KEY=
# Register this exact callback URL in the PayPal identity app; locally it defaults to localhost:3000.
RINGFENCE_SELF_RELEASE_REDIRECT_URL=

# Optional: lets you read the last verified webhook events at GET /events (Authorization: Bearer <token>)
ADMIN_TOKEN=

# Enforced in code (packages/agents/src/spend-cap.ts). Set this in addition to your provider's own
# billing-level spend limit. Defaults to the PRD's own $50 if unset.
LLM_SPEND_CAP_USD=50

# Free-tier key from aistudio.google.com -> Get API key. Powers narrateClaims() (packages/agents/src/
# narrate.ts), the one real model call: rewriting a case file claim's prose. Omit it and the console
# falls back to the original scripted sentences with no error.
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
