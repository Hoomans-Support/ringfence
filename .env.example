# Copy to .env and fill in. Never commit .env.
# Sandbox credentials: developer.paypal.com -> Apps & Credentials -> Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Set after registering the webhook in the PayPal dashboard (Apps & Credentials -> your app -> Webhooks)
PAYPAL_WEBHOOK_ID=

# Optional: lets you read the last verified webhook events at GET /events (Authorization: Bearer <token>)
ADMIN_TOKEN=

# Enforced in code (packages/agents/src/spend-cap.ts) once a real model call exists; defaults to
# the PRD's own $50 if unset. Set this in addition to your provider's own billing-level spend limit.
LLM_SPEND_CAP_USD=50
